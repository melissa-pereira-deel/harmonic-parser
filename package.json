{
  "name": "harmonic-parser",
  "private": true,
  "version": "0.1.0",
  "description": "Type a chord progression; read the key, the function of each chord, and whether the answer is ambiguous or just uncertain.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:room": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
